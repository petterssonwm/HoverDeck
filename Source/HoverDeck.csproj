<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HoverDeck.ico</ApplicationIcon>
    <AssemblyName>HoverDeck</AssemblyName>
    <RootNamespace>HoverDeck</RootNamespace>
    <Version>1.7.4</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- GitHub repository that hosts installer releases (release.ps1 publishes there). -->
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">https://github.com/petterssonwm/HoverDeck</UpdateRepository>
  </PropertyGroup>
  <ItemGroup>
    <!-- Where installed copies look for updates; set by release.ps1 (empty = updates off). -->
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\HoverDeck.ico" LogicalName="HoverDeck.App.ico" />
    <EmbeddedResource Include="Assets\HoverDeck-logo.png" LogicalName="HoverDeck.Logo.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <Target Name="ExcludeUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
